{
  "name": "kite",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check packages scripts && bun run scripts/check-boundaries.ts",
    "format": "biome check --write packages scripts",
    "test": "bun test packages",
    "build": "bun run scripts/build-host.ts",
    "check": "bun run typecheck && bun run lint && bun test packages",
    "build:node": "cargo build -p kite-node --locked",
    "docker:build": "docker compose -f deploy/docker/compose.yaml build host",
    "docker:deploy": "bun run packages/linux-host/src/docker.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "@kite/protocol": "workspace:*",
    "@kite/runtime": "workspace:*",
    "@kite/platform": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
