<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Kite</AssemblyName>
    <RootNamespace>Kite</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../android/version.properties')), '(?s)^versionName=([^\r\n]+).*$', '$1'))</Version>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
